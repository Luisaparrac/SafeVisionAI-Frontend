# Optional FastAPI base URL. Defaults to the deployed SafeVision backend.
VITE_API_URL=https://safevision-backend-pw6t.onrender.com

# Local-only Vite development gate. These are read by the Vite Node process,
# never exposed through import.meta.env or included in a production build.
# Set both values locally to enable the development sign-in form.
SAFEVISION_LOCAL_DEV_EMAIL=
SAFEVISION_LOCAL_DEV_PASSWORD=
